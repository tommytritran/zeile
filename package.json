{
  "name": "zeile",
  "displayName": "Zeile Review Map",
  "description": "A local, non-AI interactive map for reviewing TypeScript changes.",
  "version": "0.1.0",
  "publisher": "zeile-local",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "zeile.openReviewMap",
        "title": "Zeile: Open Review Map"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev:webview": "vite --host 127.0.0.1 --port 5189 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/merge": "^6.10.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@xyflow/react": "^12.8.0",
    "elkjs": "^0.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
